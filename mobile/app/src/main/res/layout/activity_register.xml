<?xml version="1.0" encoding="utf-8"?>
<!--
  Register screen – same design language as Login:
  • Brand mark centred at top
  • Eyebrow + heading "Créer votre espace"
  • Outlined inputs: Nom / Prénom / Email / Mot de passe
  • Password hint text
  • Filled primary button
  • Link back to login
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="28dp" android:paddingRight="28dp"
        android:paddingTop="52dp"
        android:paddingBottom="32dp">

        <!-- ── Brand mark ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="40dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_brand_mark">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="N"
                    android:textColor="@color/text_on_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/brand_name"
                android:textColor="@color/navy"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Eyebrow ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_eyebrow"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- ── Heading ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03"
            android:layout_marginBottom="8dp" />

        <!-- ── Subtitle ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="28dp" />

        <!-- ── Error banner ── -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error_bg"
            android:textColor="@color/error_text"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Nom label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_nom"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="16dp" />

        <!-- Prénom label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_prenom"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPrenom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_prenom"
            android:inputType="textPersonName"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="16dp" />

        <!-- Email label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_email"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="16dp" />

        <!-- Password label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_password"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_password_new"
            android:inputType="textPassword"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="6dp" />

        <!-- Password hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8 caractères minimum, une majuscule, une minuscule et un chiffre."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

        <!-- Submit button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/btn_register"
            android:textColor="@color/text_on_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            style="?attr/materialButtonStyle" />

        <!-- Login link -->
        <TextView
            android:id="@+id/tvGoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/go_login"
            android:textColor="@color/primary"
            android:gravity="center"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="40dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_footer"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
