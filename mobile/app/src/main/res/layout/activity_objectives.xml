<?xml version="1.0" encoding="utf-8"?>
<!--
  Objectives screen – mirrors web objectives page:
  • Topbar with back + title
  • Subtitle
  • RecyclerView inside a white card
  • Primary save button at bottom
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <!-- ── Topbar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Retour"
            android:textColor="@color/primary"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/objectives_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Space android:layout_width="80dp" android:layout_height="1dp" />
    </LinearLayout>

    <!-- ── Progress bar ── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        style="@style/Widget.Material3.LinearProgressIndicator"
        android:visibility="gone" />

    <!-- ── Subtitle ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/objectives_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <!-- ── Objectives list card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerObjectives"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp" android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Bottom action bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnSaveObjectives"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/btn_save_objectives"
            android:textColor="@color/text_on_dark"
            android:textSize="14sp"
            style="?attr/materialButtonStyle" />
    </LinearLayout>

</LinearLayout>
