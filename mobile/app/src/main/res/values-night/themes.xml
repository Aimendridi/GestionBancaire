        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOutline">@color/card_border</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
